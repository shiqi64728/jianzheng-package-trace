    "original_annotation_type",
    "mapped_project_status",
    "project_task",
    "requires_manual_review",
    "quarantine_status"
  ],
  "enums": {
    "original_annotation_type": ["classification", "bbox", "polygon", "pair", "statistics", "none"],
    "mapped_project_status": ["direct", "candidate", "general_only", "change_detection_only", "unmapped", "blocked"],
    "project_task": ["damage_binary_classification", "damage_detection", "damage_segmentation_candidate", "change_detection", "surface_normalization", "industry_statistics", "research_only", "blocked"],
    "quarantine_status": ["accepted", "review_required", "quarantined", "blocked"],
    "pairing_confidence": ["", "confirmed", "probable", "unresolved"]
  },
  "rules": {
    "path_style": "relative-posix",
    "external_root": "E:/JianZhengData/external",
    "forbid_absolute_paths": true,
    "forbidden_internal_fields": ["package_id", "sequence_id", "node_id", "capture_time", "first_abnormal_node"],
    "missing_license_requires": "blocked",
    "ambiguous_class_requires": ["review_required", "quarantined"],
    "raw_is_read_only": true
  }
